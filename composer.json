{
    "name": "marian/marian-hub-distribution",
    "description": "Marians TYPO3-Zentrale: Abi-Orga, Wiki/Journalismus, Sensorik und Projekte.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "marian/hub": "@dev",
        "marian/sitepackage": "@dev",
        "typo3/cms-backend": "^13.4",
        "typo3/cms-belog": "^13.4",
        "typo3/cms-beuser": "^13.4",
        "typo3/cms-core": "^13.4",
        "typo3/cms-dashboard": "^13.4",
        "typo3/cms-extbase": "^13.4",
        "typo3/cms-extensionmanager": "^13.4",
        "typo3/cms-filelist": "^13.4",
        "typo3/cms-fluid": "^13.4",
        "typo3/cms-fluid-styled-content": "^13.4",
        "typo3/cms-frontend": "^13.4",
        "typo3/cms-info": "^13.4",
        "typo3/cms-install": "^13.4",
        "typo3/cms-lowlevel": "^13.4",
        "typo3/cms-rte-ckeditor": "^13.4",
        "typo3/cms-scheduler": "^13.4",
        "typo3/cms-seo": "^13.4",
        "typo3/cms-setup": "^13.4",
        "typo3/cms-tstemplate": "^13.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^1.12",
        "typo3/testing-framework": "^8.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Marian\\Hub\\Tests\\": "packages/marian_hub/Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "typo3:setup": "typo3 setup",
        "ci:php:lint": "find packages -name '*.php' -print0 | xargs -0 -n1 -P4 php -l",
        "ci:php:stan": "phpstan analyse --no-progress",
        "ci:php:cs": "php-cs-fixer fix --dry-run --diff"
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public"
        }
    }
}
