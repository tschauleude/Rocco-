<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Sensoren</sheetTitle>
                <type>array</type>
                <el>
                    <settings.detailPid>
                        <label>Seite mit der Sensor-Detailansicht</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                        </config>
                    </settings.detailPid>
                    <settings.project>
                        <label>Nur Sensoren dieses Projekts</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_marianhub_domain_model_project</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                        </config>
                    </settings.project>
                    <settings.tableRows>
                        <label>Zeilen in der Messwerttabelle</label>
                        <config>
                            <type>number</type>
                            <size>6</size>
                            <range>
                                <lower>1</lower>
                                <upper>500</upper>
                            </range>
                            <default>25</default>
                        </config>
                    </settings.tableRows>
                    <settings.refreshSeconds>
                        <label>Automatisch neu laden (Sekunden, 0 = nie)</label>
                        <config>
                            <type>number</type>
                            <size>6</size>
                            <range>
                                <lower>0</lower>
                                <upper>3600</upper>
                            </range>
                            <default>0</default>
                        </config>
                    </settings.refreshSeconds>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
